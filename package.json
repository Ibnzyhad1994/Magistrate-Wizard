{
  "name": "magistrate-wizard",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.mjs",
  "description": "Magistrate Wizard — a legal knowledge management platform for magistrates.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "native:sync-version": "node scripts/native-sync-version.mjs",
    "native:android": "node scripts/native-platform.mjs android",
    "native:ios": "node scripts/native-platform.mjs ios",
    "native:electron": "npm run build && npm run native:sync-version && electron .",
    "native:electron:dev": "node scripts/electron-dev.mjs",
    "native:electron:dist": "npm run build && npm run native:sync-version && electron-builder --win nsis",
    "test:calendar-map": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-calendar-map.mjs",
    "test:calendar-sync": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-calendar-sync.mjs",
    "test:offline-outbox": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-offline-outbox.mjs",
    "test:session-idle": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-session-idle.mjs",
    "test:session-lock": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-session-lock-security.mjs",
    "test:export-pdf": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-export-pdf.mjs",
    "test:shares": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-shares-item-type.mjs",
    "test:judgment-versions": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-judgment-versions.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:status": "npx supabase status",
    "supabase:types": "npx supabase gen types typescript --local --schema public > src/types/database.types.ts",
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "copy:ocr-assets": "node scripts/copy-ocr-assets.mjs",
    "test:extraction": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-extraction-pipeline.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-extraction-language.mjs",
    "test:ocr": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ocr-accuracy.mjs",
    "test:ingest-formats": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ingest-document.mjs",
    "test:ingest-ocr-robustness": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ingest-ocr-robustness.mjs",
    "test:ingest-brutal": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ingest-brutal-circuit.mjs",
    "test:ingest-brutal:fast": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ingest-brutal-circuit.mjs --fast",
    "test:ingest-brutal:public": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ingest-brutal-circuit.mjs --stages=3,8",
    "test:ocr-slow-system": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ocr-slow-system.mjs",
    "test:persona-workflows": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/simulate-persona-workflows.mjs",
    "test:propose-tags-hard": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-propose-tags-hard.mjs",
    "test:propose-tags-compare": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/compare-propose-tags-before-after.mjs",
    "test:legal-extraction": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-legal-extraction.mjs",
    "test:protected-route": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-protected-route.mjs",
    "test:nav-config": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-nav-config.mjs",
    "test:audit-activity": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-audit-activity.mjs",
    "test:admin-people": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-admin-people.mjs",
    "test:pentest": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/pentest-security-audit.mjs",
    "test:seed-heuristics": "node scripts/tests/test-seed-heuristics.mjs",
    "test:docket-procedure": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-docket-procedure.mjs",
    "test:docket-week": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-docket-week.mjs",
    "test:walkthrough": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-walkthrough.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-tour-overlay.mjs",
    "test:docket-bin-purge": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-docket-matter-bin-purge.mjs",
    "test:case-law-title": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-case-law-title.mjs",
    "test:ingest-harvest-quality": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ingest-harvest-quality.mjs",
    "test:csp": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-csp.mjs",
    "seed:harvest-indexes": "node scripts/seed-legal-library/harvest-official-indexes.mjs",
    "seed:harvest-mola": "node scripts/seed-legal-library/harvest-mola-ajax.mjs",
    "seed:prepare-catalogs": "node scripts/seed-legal-library/prepare-catalogs.mjs",
    "seed:ingest": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/seed-legal-library/ingest-harvest.mjs",
    "test:ingestion": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-extraction-pipeline.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-extraction-language.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ocr-accuracy.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-false-success-prevention.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-page-awareness.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-extraction-quality.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-text-sanitize.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-legal-extraction.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ingest-document.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-bulk-ingestion.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ingest-ocr-robustness.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-protected-route.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-nav-config.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-admin-people.mjs && node scripts/tests/test-seed-heuristics.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-docket-procedure.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ingest-harvest-quality.mjs",
    "test:ingestion:full": "npm run test:ingestion && npm run test:ingest-brutal:fast"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/network": "^6.0.3",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@hookform/resolvers": "^3.9.1",
    "@napi-rs/canvas": "^1.0.5",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@sentry/react": "^10.73.0",
    "@supabase/supabase-js": "^2.46.1",
    "@tanstack/react-query": "^5.59.20",
    "@tanstack/react-query-devtools": "^5.59.20",
    "@tiptap/extension-link": "^2.9.1",
    "@tiptap/extension-placeholder": "^2.9.1",
