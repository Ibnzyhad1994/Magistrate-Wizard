{
  "name": "magistrate-wizard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Magistrate Wizard — a legal knowledge management platform for magistrates.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:status": "npx supabase status",
    "supabase:types": "npx supabase gen types typescript --local --schema public > src/types/database.types.ts",
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "copy:ocr-assets": "node scripts/copy-ocr-assets.mjs",
    "test:extraction": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-extraction-pipeline.mjs",
    "test:ocr": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ocr-accuracy.mjs",
    "test:ingest-formats": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ingest-document.mjs",
    "test:ingest-ocr-robustness": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ingest-ocr-robustness.mjs",
    "test:ingest-brutal": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ingest-brutal-circuit.mjs",
    "test:ingest-brutal:fast": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ingest-brutal-circuit.mjs --fast",
    "test:ocr-slow-system": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ocr-slow-system.mjs",
    "test:persona-workflows": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/simulate-persona-workflows.mjs",
    "test:ingestion": "node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-extraction-pipeline.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ocr-accuracy.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-false-success-prevention.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-page-awareness.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-extraction-quality.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-text-sanitize.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-legal-extraction.mjs && node --experimental-strip-types --import ./scripts/test-support/register.mjs scripts/tests/test-ingest-document.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@napi-rs/canvas": "^1.0.5",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@supabase/supabase-js": "^2.46.1",
    "@tanstack/react-query": "^5.59.20",
    "@tanstack/react-query-devtools": "^5.59.20",
    "@tiptap/extension-link": "^2.9.1",
    "@tiptap/extension-placeholder": "^2.9.1",
    "@tiptap/extension-underline": "^2.9.1",
    "@tiptap/pm": "^2.9.1",
    "@tiptap/react": "^2.9.1",
    "@tiptap/starter-kit": "^2.9.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.454.0",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-router-dom": "^6.28.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
