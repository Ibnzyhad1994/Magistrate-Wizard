# Local Supabase (`npm run db:start`, then copy values from `npm run db:status`)
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=your-local-anon-key

# Android emulator cannot reach the host loopback. Use the emulator alias:
# VITE_SUPABASE_URL=http://10.0.2.2:55321
# Windows / Electron keep http://127.0.0.1:55321

# Optional: used by `npm run supabase:types` against a hosted project
SUPABASE_PROJECT_ID=your-project-ref

# Google Calendar (PKCE public clients — no client secret in the app)
# Create OAuth clients in Google Cloud for Web, Desktop, Android, iOS.
# See docs/native-and-calendar.md for redirect URIs.
VITE_GOOGLE_OAUTH_CLIENT_ID_WEB=
VITE_GOOGLE_OAUTH_CLIENT_ID_DESKTOP=
VITE_GOOGLE_OAUTH_CLIENT_ID_ANDROID=
VITE_GOOGLE_OAUTH_CLIENT_ID_IOS=
# Optional override. Defaults: current origin /settings (web),
# http://127.0.0.1:<ephemeral>/oauth/google/callback (Electron),
# magistratewizard://oauth/google/callback (Capacitor)
# VITE_GOOGLE_OAUTH_REDIRECT_URI=
